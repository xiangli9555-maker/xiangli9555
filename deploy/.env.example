# === Vo Manager 环境变量 · 复制到 .env 后填写 ===
# 注意：以下必填项留空时 docker compose 会拒绝启动，避免弱默认配置进入生产。

# MySQL：root 仅供数据库容器初始化；后端使用最小权限业务账号。
DB_ROOT_PASSWORD=
DB_NAME=vo_manager
DB_USER=vo_manager
DB_PASSWORD=

# API 鉴权与 RBAC（必填）
# JSON 数组，每个 token 至少 32 个字符；角色仅允许 viewer/editor/admin。
# 示例格式（请替换为随机令牌，不要提交真实值）：
# [{"token":"<random-32+-chars>","subject":"root","role":"admin"},{"token":"<random-32+-chars>","subject":"vo-editor","role":"editor"},{"token":"<random-32+-chars>","subject":"vo-viewer","role":"viewer"}]
API_TOKENS_JSON=

# 默认只允许同源。仅当确需跨域前端时，填逗号分隔的完整 Origin，例如：https://vomi.example.com
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=180
MAX_AUDIO_BYTES=104857600

# 外部系统凭据（可选）
DFAI_API_TOKEN=
WECOM_CORPID=
WECOM_CORPSECRET=

# Nginx 上传上限
MAX_UPLOAD_SIZE=100M
