# ===== Vo Manager 后端环境变量 =====
# 复制为 .env 后填入真实值（.env 不入库）

NODE_ENV=production

# --- MySQL（使用业务账号，不使用 root）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vo_manager
DB_PASSWORD=
DB_NAME=vo_manager
DB_CONNECTION_LIMIT=10

# --- 服务 ---
PORT=3001
AUDIO_DIR=/data/audio
JSON_BODY_LIMIT=2mb
MAX_AUDIO_BYTES=104857600
RATE_LIMIT_PER_MINUTE=180

# --- 鉴权 / RBAC / CORS ---
# 必填。token 至少 32 字符；role 仅 viewer/editor/admin。
API_TOKENS_JSON=
# 默认只允许同源；确需跨域时填写逗号分隔的完整 Origin。
ALLOWED_ORIGINS=
# 仅本地开发临时使用；生产 NODE_ENV=production 时不会生效。
ALLOW_INSECURE_DEV=false

# --- 企业微信 · 智能表格（可选）---
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_PLANNER_MAP={}

# --- TAPD / DFAI 同步（可选）---
DFAI_TOKEN=
