# ===== Vo Manager 后端环境变量 =====
# 复制为 .env 后填入真实值（.env 不入库）

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vo_manager

# --- 服务 ---
PORT=3001
AUDIO_DIR=/data/audio

# --- 企业微信 · 智能表格（台词表录入/汇总）---
# 企业 ID：企业微信管理后台 → 我的企业 → 企业信息
WECOM_CORPID=
# 自建应用 Secret：应用管理 → 你的应用 → Secret（需开启「智能表格」权限）
WECOM_CORPSECRET=
# 应用可见范围需包含文案策划；并在「协作 → 文档 → API → 可调用接口的应用」勾选本应用
# 应用详情页需配置「企业可信IP」= 本后端服务器出口 IP

# 文案策划显示名 -> 企业微信账号ID 映射（用于建文档归属 + 分享编辑权限）
# 格式：{"文案A":"zhangsan","文案B":"lisi"}
WECOM_PLANNER_MAP={}

# --- TAPD / DFAI 同步（未来启用）---
# DFAI_TOKEN=
